      "parameters": {
        "jsCode": "const allResults = $input.all();\nconst passed = [];\nconst failed = [];\n\nfor (const item of allResults) {\n  const r = item.json;\n  if (r.passed) passed.push(r);\n  else failed.push(r);\n}\n\npassed.sort((a, b) => (b.score || 0) - (a.score || 0));\n\nreturn [{\n  json: {\n    passed,\n    failed,\n    hasPassed: passed.length > 0,\n    chatId: $('Парсинг решения').first().json.chatId,\n    businessTask: $('Парсинг решения').first().json.businessTask\n  }\n}];"
      },
