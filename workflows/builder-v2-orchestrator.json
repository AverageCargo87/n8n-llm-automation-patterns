    {
      "parameters": {
        "jsCode": "const passed = $input.first().json.passed;\nlet msg = '<b>✅ Найдены подходящие шаблоны:</b>\\n\\n';\n\nfor (let i = 0; i < passed.length; i++) {\n  const t = passed[i];\n  \n  msg += `<b>${i + 1}. ${t.templateName || 'Unknown'}</b>\\n`;\n  \n  // Тип теста\n  msg += `📋 <i>${t.testType || 'Анализ'}</i>\\n`;\n  \n  // Оценка с визуальной шкалой\n  const score = t.score || 0;\n  const bars = Math.round(score / 10);\n  const scoreBar = '█'.repeat(bars) + '░'.repeat(10 - bars);\n  msg += `📊 Оценка: ${score}/100 [${scoreBar}]\\n`;\n  \n  // Краткое резюме\n  msg += `💬 ${t.summary || ''}\\n`;\n  \n  // Тип триггера\n  const triggerShort = (t.triggerType || '').replace('n8n-nodes-base.', '');\n  msg += `⚡ Триггер: ${triggerShort}\\n`;\n  \n  // Проблемы если есть\n  if (t.issues && t.issues.length > 0) {\n    msg += `⚠️ Проблемы:\\n`;\n    t.issues.forEach(issue => {\n      msg += `  • ${issue}\\n`;\n    });\n  }\n  \n  // Детальные проверки (только провалившиеся)\n  if (t.checks && t.checks.length > 0) {\n    const failedChecks = t.checks.filter(c => c.startsWith('❌') || c.startsWith('⚠️'));\n    if (failedChecks.length > 0) {\n      msg += `🔍 Замечания:\\n`;\n      failedChecks.forEach(check => {\n        msg += `  ${check}\\n`;\n      });\n    }\n  }\n  \n  // Ссылка на шаблон\n  if (t.templateUrl) {\n    msg += `🔗 <a href=\"${t.templateUrl}\">Скачать шаблон</a>\\n`;\n  }\n  \n  msg += '\\n';\n}\n\n// Рекомендация (лучший шаблон)\nif (passed.length > 1) {\n  const best = passed[0];\n  msg += `💡 <b>Рекомендуем:</b> ${best.templateName}`;\n}\n\nmsg += '\\n🏗 Хотите кастомный воркфлоу? Напишите /build с описанием задачи';\n\nreturn [{ json: { message: msg, chatId: $input.first().json.chatId } }];"
      },
