    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json.output ||\n                    $input.first().json.templates;\nlet templates = [];\n\ntry {\n  if (Array.isArray(agentOutput)) {\n    templates = agentOutput;\n  } else if (typeof agentOutput === 'string') {\n    // Пробуем найти JSON массив в строке\n    const match = agentOutput.match(/\\[[\\s\\S]*\\]/);\n    if (match) {\n      templates = JSON.parse(match[0]);\n    }\n  }\n} catch (e) {\n  templates = [];\n}\n\n// Фильтрация: оставляем только ВЫСОКАЯ и СРЕДНЯЯ релевантность\ntemplates = templates.filter(t => {\n  if (!t || !t.filename) return false;\n  \n  const rel = (t.relevance || '').toUpperCase();\n  // Принимаем: ВЫСОКАЯ, СРЕДНЯЯ, HIGH, MEDIUM\n  return rel.includes('ВЫСОК') || \n         rel.includes('СРЕДН') || \n         rel === 'HIGH' || \n         rel === 'MEDIUM';\n});\n\n// Максимум 3 шаблона\ntemplates = templates.slice(0, 3);\n\nreturn [{\n  json: {\n    templates,\n    hasTemplates: templates.length > 0,\n    chatId: $('Парсинг решения').first().json.chatId,\n    businessTask: $('Парсинг решения').first().json.businessTask\n  }\n}];"
      },
