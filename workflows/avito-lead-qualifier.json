    {
      "parameters": {
        "functionCode": "const body = items[0].json.body || items[0].json;\nconst payload = body.payload || body;\nconst value = payload.value || payload;\n\nconst chat_id = String(value.chat_id || body.chat_id || '');\nconst user_id = String(value.user_id || body.user_id || '');\nconst author_id = String(value.author_id || body.author_id || '');\nconst content = value.content || {};\nconst text = content.text || value.text || '';\nconst userName = value.author_name || body.author_name || 'Клиент';\n\n// ФИЛЬТР: пропускаем свои сообщения\nif (author_id === user_id) {\n  return [];  // пустой массив = нода ничего не передаёт дальше\n}\n\nif (!chat_id || !text) {\n  return [];\n}\n\nreturn [{ json: { chat_id, user_id, author_id, text, userName } }];"
      },
