    {
      "parameters": {
        "chatId": "<CHAT_ID>",
        "text": "=🔔 Новый квалифицированный лид!\n\nСтатус: {{$node['Парсим ответ AI'].json[\"status\"]}}\n👤 {{$node['Парсим ответ AI'].json[\"userName\"]}}\n💬 Задача: {{$node['Парсим ответ AI'].json[\"zadacha\"]}}\n💰 Бюджет: {{$node['Парсим ответ AI'].json[\"budget\"]}}\n⏱ Срок: {{$node['Парсим ответ AI'].json[\"srok\"]}}",
        "additionalFields": {}
