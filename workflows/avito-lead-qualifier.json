    {
      "parameters": {
        "functionCode": "const parsed = $node['Парсинг'].json;\nconst sheets = items[0].json;\n\n// Собираем предыдущую историю\nconst prevHistory = sheets.history || '';\n\n// Добавляем новое сообщение клиента\nconst updatedHistory = prevHistory \n  ? prevHistory + '\\nКлиент: ' + parsed.text\n  : 'Клиент: ' + parsed.text;\n\nreturn [{\n  json: {\n    chat_id: parsed.chat_id,\n    user_id: parsed.user_id,\n    userName: parsed.userName,\n    text: parsed.text,\n    history: updatedHistory,\n    messageCount: (sheets.messageCount ? parseInt(sheets.messageCount) : 0) + 1\n  }\n}];"
      },
      "id": "5f694e92-56c6-4653-8459-6b28ff924337",
      "name": "Собрать контекст",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -288,
        1040
      ]
    },
    {
      "parameters": {
        "functionCode": "const prev = $node['Собрать контекст'].json;\nconst raw = items[0].json.output || items[0].json.text || '';\n\nlet ai;\ntry {\n  const clean = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  ai = JSON.parse(clean);\n} catch(e) {\n  ai = { reply: raw, zadacha: '', budget: '', srok: '', status: 'collecting' };\n}\n\nconst updatedHistory = prev.history + '\\nБот: ' + ai.reply;\n\nreturn [{\n  json: {\n    chat_id:  prev.chat_id,\n    user_id:  prev.user_id,\n    userName: prev.userName,\n    reply:    ai.reply,\n    zadacha:  ai.zadacha || '',\n    budget:   ai.budget || '',\n    srok:     ai.srok || '',\n    status:   ai.status || 'collecting',\n    history:  updatedHistory,\n    messageCount: prev.messageCount\n  }\n}];"
      },
