              "lookupColumn": "phone",
              "lookupValue": "={{ $json.phone }}"
            }
          ]
        },
        "options": {
          "returnFirstMatch": true
        }
      },
      "id": "1c752dfe-9210-45b1-b32c-ad4c6971c7d7",
      "name": "Search Duplicate",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -720,
        128
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Проверяем найден ли дубль\nconst lead = $('Normalize Lead').item.json;\nconst dupRow = $json;\n\n// Дубль если нашли строку с phone и status != 'duplicate' (чтоб не блочить вечно)\nconst isDuplicate = !!(dupRow && dupRow.phone && (dupRow.status === 'created' || dupRow.status === 'amo_failed'));\n\nreturn {\n  json: {\n    ...lead,\n    is_duplicate: isDuplicate,\n    original_lead_id: dupRow?.amo_lead_id || null,\n    original_timestamp: dupRow?.timestamp || null\n  }\n};"
      },
      "id": "fe4622d9-3263-4cdd-8ede-efe3c3a019c1",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        128
      ]
    },
