            "source": "={{ $json.source }}",
            "name": "={{ $json.name }}",
            "phone": "={{ $json.phone }}",
            "comment": "={{ $json.comment }}",
            "status": "duplicate",
            "amo_lead_id": "",
            "error": "={{ 'Дубль номера. Оригинал #' + ($json.original_lead_id || '?') + ' от ' + ($json.original_timestamp || '?') }}",
            "username": "={{ $json.username }}"
          }
        },
        "options": {}
      },
      "id": "b81c677f-2574-409c-8fa8-da0596157d89",
      "name": "Log Duplicate",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        32,
        32
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('⚙️ Config').item.json.tg_chat_id }}",
        "text": "=⚠️ <b>Дубль заявки</b>\n\n👤 {{ $json.name }}\n📞 {{ $json.phone }}\n🔗 Источник: {{ $json.source }}\n💬 {{ $json.comment }}\n\n<i>Оригинал лида: #{{ $json.original_lead_id || '?' }} ({{ $json.original_timestamp || '?' }})</i>\n<i>В amoCRM не отправлено</i>",
        "additionalFields": {
          "<AIRTABLE_BASE_ID>": false,
          "parse_mode": "HTML"
        }
      },
      "id": "2e7d61b5-128e-4eb2-a715-35b9ca55a37a",
      "name": "TG: Notify Duplicate",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
