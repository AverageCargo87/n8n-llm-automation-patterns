          "value": {
            "timestamp": "={{ $json.received_at }}",
            "source": "={{ $json.source }}",
            "name": "={{ $json.name }}",
            "phone": "={{ $json.phone }}",
            "comment": "={{ $json.comment }}",
            "status": "={{ $json.amo_status }}",
            "amo_lead_id": "={{ $json.amo_lead_id || '' }}",
            "error": "={{ $json.amo_error || '' }}",
            "username": "={{ $json.username }}"
          }
        },
        "options": {}
      },
      "id": "a508ccc1-e44d-4304-a702-ddf16f799b98",
      "name": "Log New Lead",
