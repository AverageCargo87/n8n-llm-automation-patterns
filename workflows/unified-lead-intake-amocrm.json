        "options": {}
      },
      "id": "24c11d62-3e27-4d25-b1af-d5fe74e98281",
      "name": "⚙️ Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1472,
        224
      ]
    },
    {
      "parameters": {
        "content": "## ⚙️ Заполнить перед запуском\n- `amocrm_subdomain` — поддомен amoCRM\n- `amocrm_phone_field_id` — ID поля «Телефон» в контактах amoCRM\n- `tg_chat_id` — ID чата для уведомлений (взять у @userinfobot)\n- `gsheet_id` — ID Google Sheets таблицы\n\n**Лист «Лог заявок» — колонки:**\ntimestamp | source | name | phone | comment | status | amo_lead_id | error | username",
        "height": 260,
        "width": 320,
        "color": 7
      },
      "id": "454c587a-e1ea-4d6e-bd34-710f0e42e783",
      "name": "⚙️ Config Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1504,
        496
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Нормализуем входящие данные с обоих источников\nconst body = $('Webhook: Lead Intake').item.json.body || $('Webhook: Lead Intake').item.json;\nconst cfg = $('⚙️ Config').first().json;\n\n// Нормализация телефона: убираем всё кроме цифр, приводим к формату +7XXXXXXXXXX\nlet phoneRaw = String(body.phone || body.tel || body.phonenumber || '').trim();\nlet phoneDigits = phoneRaw.replace(/\\D/g, '');\nif (phoneDigits.startsWith('8') && phoneDigits.length === 11) phoneDigits = '7' + phoneDigits.substring(1);\nif (phoneDigits.length === 10) phoneDigits = '7' + phoneDigits;\nconst phoneNormalized = phoneDigits ? '+' + phoneDigits : '';\n\nconst source = (body.source || 'unknown').toLowerCase();\nconst name = String(body.name || body.fullname || 'Без имени').trim();\nconst comment = String(body.comment || body.message || body.text || '').trim();\nconst username = String(body.username || '').trim();\n\n// Валидация: телефон обязателен\nconst valid = phoneNormalized.length >= 11;\n\nreturn {\n  json: {\n    source,\n    name,\n    phone: phoneNormalized,\n    phone_search: phoneDigits, // для поиска без + (Sheets иногда сохраняет так)\n    comment,\n    username,\n    valid,\n    received_at: new Date().toISOString(),\n    raw: body,\n    cfg\n  }\n};"
      },
      "id": "1b6a299b-4697-4ad8-ac93-855a8b9e93b1",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1216,
        224
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
