      "id": "ebb5e845-dd58-4d77-9ab6-387abcebb60a",
      "name": "Respond 409",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        544,
        32
      ]
    },
    {
      "parameters": {
        "content": "## 🟢 Ветка НОВАЯ заявка\n1. POST в amoCRM /leads/complex\n2. Парсим ответ\n3. Лог в Sheets со status=created\n4. TG-уведомление\n5. Respond 200",
        "height": 180,
        "width": 280,
        "color": 3
      },
      "id": "3b7ec27e-25a1-476a-a645-1545dd06e951",
      "name": "🟢 New Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        32,
        224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('⚙️ Config').item.json.amocrm_subdomain }}.amocrm.ru/api/v4/leads/complex",
        "authentication": "<AUTHENTICATION>",
        "nodeCredentialType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ name: 'Заявка с ' + $json.source, price: $('⚙️ Config').item.json.default_lead_price, _embedded: { contacts: [{ name: $json.name, custom_fields_values: [{ field_id: $('⚙️ Config').item.json.amocrm_phone_field_id, values: [{ value: $json.phone, enum_code: 'MOB' }] }] }] } }]) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "1efe5018-dea2-4370-8b5e-d87e90df8dbf",
      "name": "amoCRM: Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        32,
        432
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Парсим ответ amoCRM\nconst lead = $('Check Duplicate').item.json;\nconst resp = $json;\n\nlet leadId = null;\nlet status = 'created';\nlet error = null;\n\ntry {\n  // Успешный ответ amoCRM /leads/complex\n  if (Array.isArray(resp) && resp[0]?.id) {\n    leadId = resp[0].id;\n  } else if (resp._embedded?.leads?.[0]?.id) {\n    leadId = resp._embedded.leads[0].id;\n  } else if (resp.id) {\n    leadId = resp.id;\n  } else {\n    status = 'amo_failed';\n    error = 'amoCRM не вернул ID лида: ' + JSON.stringify(resp).substring(0, 300);\n  }\n} catch (e) {\n  status = 'amo_failed';\n  error = e.message;\n}\n\nreturn {\n  json: {\n    ...lead,\n    amo_lead_id: leadId,\n    amo_status: status,\n    amo_error: error,\n    amo_response: resp\n  }\n};"
      },
      "id": "0accad0b-f288-4c66-b1ed-674d33ebb701",
      "name": "Parse amoCRM Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        432
      ]
    },
    {
      "parameters": {
        "authentication": "<AUTHENTICATION>",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('⚙️ Config').item.json.gsheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('⚙️ Config').item.json.gsheet_log_name }}",
          "mode": "name"
        },
        "columns": {
