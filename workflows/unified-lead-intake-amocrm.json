              "leftValue": "={{ $json.is_duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "822fa5ca-2697-46c9-9bd0-ac6881cbd36e",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        128
      ]
    },
    {
      "parameters": {
        "content": "## 🔴 Ветка ДУБЛЬ\n- Логируем как duplicate\n- Уведомляем в TG (чтобы видеть попытки)\n- Возвращаем 409\n- В amoCRM НЕ отправляем",
        "width": 280,
        "color": 2
      },
      "id": "8120212b-53fe-4c36-be53-06f2d3d410b3",
      "name": "🔴 Dup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        32,
        -176
