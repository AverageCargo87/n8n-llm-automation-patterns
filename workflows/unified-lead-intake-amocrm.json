    {
      "parameters": {
        "chatId": "={{ $('⚙️ Config').item.json.tg_chat_id }}",
        "text": "={{ ($json.amo_status === 'created' ? '✅ <b>Новая заявка</b>' : '⚠️ <b>Заявка получена, НО amoCRM упал!</b>') }}\n\n👤 {{ $json.name }}\n📞 {{ $json.phone }}\n🔗 Источник: {{ $json.source }}\n💬 {{ $json.comment || '—' }}\n{{ $json.username ? '🆔 ' + $json.username : '' }}\n\n{{ $json.amo_lead_id ? '🆔 amoCRM Lead: <code>' + $json.amo_lead_id + '</code>' : '❌ amoCRM error: ' + ($json.amo_error || 'unknown') }}",
        "additionalFields": {
          "<AIRTABLE_BASE_ID>": false,
          "parse_mode": "HTML"
        }
      },
      "id": "e5bc17bd-39f5-4d62-8ebe-886f19f3562d",
      "name": "TG: Notify New Lead",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        784,
